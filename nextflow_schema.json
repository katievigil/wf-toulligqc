{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/katievigil/wf-toulligqc/main/nextflow_schema.json",
  "title": "katievigil/wf-toulligqc",
  "description": "Quality control workflow for Oxford Nanopore sequencing data using ToulligQC",
  "type": "object",

  "properties": {

    "input_files": {
      "type": "string",
      "enum": [
        "sequencing_summary only",
        "sequencing_summary + telemetry_source",
        "telemetry_source + fast5",
        "fastq/ bam only"
      ],
      "default": "sequencing_summary only"
    },

    "sequencing_summary_source": { "type": "string", "format": "file-path" },
    "telemetry_source": { "type": "string", "format": "file-path" },
    "fast5_source": { "type": "string", "format": "file-path" },
    "fastq_source": { "type": "string", "format": "file-path" },
    "bam_source": { "type": "string", "format": "file-path" },

    "barcoding": { "type": "boolean", "default": false },
    "barcodes": { "type": "string" },

    "barcoding_summary_pass": { "type": "string", "format": "file-path" },
    "barcoding_summary_fail": { "type": "string", "format": "file-path" },

    "out_dir": {
      "type": "string",
      "default": "output",
      "format": "directory-path"
    },

    "report_name": { "type": "string" },
    "disable_ping": { "type": "boolean", "default": false }
  },

  "anyOf": [
    { "required": ["sequencing_summary_source"] },
    { "required": ["telemetry_source"] },
    { "required": ["fast5_source"] },
    { "required": ["fastq_source"] },
    { "required": ["bam_source"] }
  ]
}
