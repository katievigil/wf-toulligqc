{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "wf-toulligqc",
  "description": "ToulligQC workflow",
  "type": "object",

  "properties": {
    "sequencing_summary_source": {
      "type": "string",
      "title": "Sequencing summary file"
    },
    "telemetry_source": {
      "type": "string",
      "title": "Telemetry file"
    },
    "fast5_source": {
      "type": "string",
      "title": "FAST5 directory"
    },
    "fastq_source": {
      "type": "string",
      "title": "FASTQ file"
    },
    "bam_source": {
      "type": "string",
      "title": "BAM file"
    },
    "out_dir": {
      "type": "string",
      "default": "output",
      "title": "Output directory"
    },
    "report_name": {
      "type": "string",
      "default": "ToulligQC_report",
      "title": "Report name"
    }
  }
}
